# API Configuration
API_BASE_URL=http://localhost:8000/api
WS_BASE_URL=ws://localhost:8000/ws

# Authentication
JWT_SECRET_KEY=your-jwt-secret-key-here

# Google OAuth
GOOGLE_CLIENT_ID_ANDROID=your-google-client-id-android.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=your-google-client-id-ios.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=your-google-client-id-web.apps.googleusercontent.com

# Apple Sign-In
APPLE_SERVICE_ID=com.margdarshak.signin

# Maps & Routing
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Environment
NODE_ENV=development
